<gcard>
<option name="DBHOST" value="clasdb.jlab.org"/>
<option name="DATABASE" value="clas12_simulation"/>
<option name="HIT_PROCESS_LIST" value="BDX"/>
<detector name="bdx" factory="TEXT" variation="proposal"/>
<option name="INTEGRATEDRAW" value="cormo flux scint crs"/>
<option name="geometry" value="900x600"/>
<option name="HALL_MATERIAL"   value="Vacuum" />
<option name="HALL_DIMENSIONS" value="100.*m,100.*m,100.*m" />
<option name="MAX_X_POS"   value="50000." />
<option name="MAX_Y_POS"   value="30000." />
<option name="MAX_Z_POS"   value="50000." />

<!--<option name="PHYSICS"   value="FTFP_BERT_HP + STD + HP" />-->
<option name="PHYSICS"   value="STD + HP" />

<!--<option name="INTEGRATEDRAW" value="cormo flux veto crs"/>-->
	

<option name="ENERGY_CUT"   value="1.0*MeV" />
<option name="RECORD_PASSBY" value="0" />

<option name="INPUT_GEN_FILE" value="LUND, /Users/fredericduch/Desktop/BDX/data/sim_reco/highangle.lund" />

<option name="USE_GUI" value="1"/>

</gcard>