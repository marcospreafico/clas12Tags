# Copy to farm/ifarm.env and adapt to the modules available on your ifarm account.
# Sourced on both build and compute nodes; never depends on the submit shell.
module purge
module use /scigroup/cvmfs/hallb/clas12/sw/modulefiles
module use /cvmfs/jlab.opensciencegrid.org/geant4/modules
module load python/3.13.7 geant4/10.7.4 .scons_bm/dev .cmag/1.1 .mlibrary/dev ccdb/1.99.7 hipo/4.5.0
export BDX_EXPECTED_GEANT4=10.7.4
